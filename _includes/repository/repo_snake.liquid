<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}">
    <span class="d-none d-sm-none d-md-block">
      <img
        class="only-light"
        alt="{{ include.username }} contributions"
        src="https://raw.githubusercontent.com/{{ include.username }}/{{ include.username }}/output/github-contribution-grid-snake.svg#gh-light-mode-only"
      >
      <img
        class="only-dark"
        alt="{{ include.username }} contributions"
        src="https://raw.githubusercontent.com/{{ include.username }}/{{ include.username }}/output/github-contribution-grid-snake.svg#gh-dark-mode-only"
      >
    </span>

    <span class="d-none d-sm-block d-md-none">
      <img
        class="only-light"
        alt="{{ include.username }} contributions"
        src="https://raw.githubusercontent.com/{{ include.username }}/{{ include.username }}/output/github-contribution-grid-snake.svg#gh-light-mode-only"
      >
      <img
        class="only-dark"
        alt="{{ include.username }} contributions"
        src="https://raw.githubusercontent.com/{{ include.username }}/{{ include.username }}/output/github-contribution-grid-snake.svg#gh-dark-mode-only"
      >
    </span>

    <span class="d-block d-sm-none">
      <img
        class="only-light"
        alt="{{ include.username }} contributions"
        src="https://raw.githubusercontent.com/{{ include.username }}/{{ include.username }}/output/github-contribution-grid-snake.svg#gh-light-mode-only"
      >
      <img
        class="only-dark"
        alt="{{ include.username }} contributions"
        src="https://raw.githubusercontent.com/{{ include.username }}/{{ include.username }}/output/github-contribution-grid-snake.svg#gh-dark-mode-only"
      >
    </span>
  </a>
</div>
