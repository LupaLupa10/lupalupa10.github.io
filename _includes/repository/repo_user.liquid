<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}" class="repo-card repo-card--user">
    <div class="repo-card__icon">
      <i class="fa-brands fa-github"></i>
    </div>
    <div class="repo-card__body">
      <h3 class="repo-card__title">{{ include.username }}</h3>
      <p class="repo-card__meta">GitHub profile</p>
    </div>
  </a>
</div>
