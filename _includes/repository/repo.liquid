{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}" class="repo-card">
    <div class="repo-card__icon">
      <i class="fa-brands fa-github"></i>
    </div>
    <div class="repo-card__body">
      <h3 class="repo-card__title">{{ repo_url[1] }}</h3>
      {% if show_owner %}
        <p class="repo-card__meta">{{ repo_url[0] }}</p>
      {% endif %}
      <p class="repo-card__meta">{{ include.repository }}</p>
    </div>
  </a>
</div>
